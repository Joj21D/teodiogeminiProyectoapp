<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="#F0F0F0"
              android:fitsSystemWindows="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#4CAF50"
            android:elevation="4dp"
            android:gravity="center_vertical">

        <ImageButton
                android:id="@+id/btn_volver_resumen"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF"/>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen General"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/tv_resumen_fecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando fecha... 📅"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@android:drawable/btn_default"
                    android:layout_marginBottom="16dp"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="18sp"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="12dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monto Total del Día (Neto)"
                        android:textColor="#757575"
                        android:textSize="14sp"/>

                <TextView
                        android:id="@+id/tv_resumen_monto_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$ 0"
                        android:textColor="#000000"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeMaxTextSize="28sp"/>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="12dp">

                <TextView
                        android:id="@+id/tv_resumen_venta_mayor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Venta Mayor: $ 0 (Ninguna)"
                        android:textColor="#4CAF50"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="16sp"/>

                <TextView
                        android:id="@+id/tv_resumen_gasto_mayor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gasto Mayor: $ 0 (Ninguno)"
                        android:textColor="#F44336"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="12dp">

                <TextView
                        android:id="@+id/tv_resumen_diferencia_ayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Diferencia de ayer: $ 0"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="16sp"/>

                <TextView
                        android:id="@+id/tv_resumen_neto_mes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Neto Acumulado por mes: $ 0"
                        android:textColor="#2196F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:elevation="2dp">

                <TextView
                        android:id="@+id/tv_resumen_cant_compras"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compras: 0"
                        android:textColor="#000000"
                        android:textSize="16sp"/>

                <TextView
                        android:id="@+id/tv_resumen_cant_ventas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ventas: 0"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:gravity="end"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>