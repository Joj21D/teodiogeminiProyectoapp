<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="20dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalle del Registro"
                android:textColor="#2196F3"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:gravity="center"/>

        <TextView
                android:id="@+id/tvDetalleFechaDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha: 00/00/0000"
                android:textColor="#757575"
                android:textSize="14sp"
                android:textStyle="italic"
                android:layout_marginBottom="12dp"
                android:gravity="center"/>

        <RadioGroup
                android:id="@+id/rgDetalleTipoTransaccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

            <RadioButton
                    android:id="@+id/rbDetalleCompra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gasto"
                    android:clickable="false"
                    android:focusable="false"
                    android:textColor="#000000"
                    android:layout_weight="1"/>

            <RadioButton
                    android:id="@+id/rbDetalleVenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingreso"
                    android:clickable="false"
                    android:focusable="false"
                    android:textColor="#000000"
                    android:layout_weight="1"/>
        </RadioGroup>

        <EditText
                android:id="@+id/etDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Proveedor"
                android:textColorHint="#9E9E9E"
                android:focusable="false"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

            <EditText
                    android:id="@+id/etDetallePrecio"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="Monto / Precio"
                    android:textColorHint="#9E9E9E"
                    android:inputType="numberDecimal"
                    android:focusable="false"
                    android:textColor="#000000"/>

            <EditText
                    android:id="@+id/etDetalleCantidad"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:hint="Cantidad ( 1 )"
                    android:textColorHint="#9E9E9E"
                    android:inputType="number"
                    android:focusable="false"
                    android:textColor="#000000"
                    android:layout_marginStart="8dp"/>
        </LinearLayout>

        <EditText
                android:id="@+id/etDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descripción"
                android:textColorHint="#9E9E9E"
                android:focusable="false"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <Button
                    android:id="@+id/btnDetalleBorrar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Borrar"
                    android:maxLines="1"
                    android:padding="4dp"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp"
                    android:textSize="12sp"/>

            <Button
                    android:id="@+id/btnDetalleEditar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Editar"
                    android:maxLines="1"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    android:textSize="12sp"/>

            <Button
                    android:id="@+id/btnDetalleGuardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Guardar"
                    android:maxLines="1"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp"
                    android:textSize="12sp"/>

            <Button
                    android:id="@+id/btnDetalleCerrar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cerrar"
                    android:maxLines="1"
                    android:padding="4dp"
                    android:backgroundTint="#9E9E9E"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>